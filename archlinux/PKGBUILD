# Maintainer: nathawat <nathawat[at]noreply[dot]codeberg[dot]org>

pkgname=21mw-ir-emitter
pkgver=1.0.1
pkgrel=1
pkgdesc='Tiny helper for the Chicony IR emitter on Lenovo 21MW systems'
arch=('x86_64')
url='https://codeberg.org/nathawat/21mw-ir-emitter'
license=('Apache-2.0')
depends=('systemd')
makedepends=('gcc')

_tag=v${pkgver}

source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${_tag}.tar.gz")
b2sums=('51eb94906aa0c74217164bbbd1cc29a57a24626fdb3e5fbec609ff2ae4628b6103d8ea297a001ffb4804d9f75e861af9fe722b450b9846f7345f47c97052c9a5')

build() {
	cd "$srcdir/$pkgname"
	make
}

check() {
	cd "$srcdir/$pkgname"
	make check
}

package() {
	cd "$srcdir/$pkgname"
	make DESTDIR="$pkgdir" PREFIX=/usr install
}
