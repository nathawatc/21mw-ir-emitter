# Maintainer: Scott <158021536+nathawatc@users.noreply.github.com>
# shellcheck shell=bash disable=SC2034,SC2154,SC2164

pkgname=21mw-ir-emitter
pkgver=1.0.4
pkgrel=1
pkgdesc='Tiny helper for the Chicony IR emitter on Lenovo 21MW systems'
arch=('x86_64')
url='https://github.com/nathawatc/21mw-ir-emitter'
license=('Apache-2.0')
depends=('systemd')
makedepends=('gcc')
options=('!strip')

_tag=v${pkgver}

source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${_tag}.tar.gz")
b2sums=('5d0d12f4a949e20f4e85bafa508180efc7a28831ba5857ee663fc509682e7d85ac0851621daf6f3b5492f9e856db0698c0927b5fb848e2c8ae950bebde11d745')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	make
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
