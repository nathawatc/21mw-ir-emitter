# Maintainer: Scott <158021536+nathawatc@users.noreply.github.com>
# shellcheck shell=bash disable=SC2034,SC2154,SC2164

pkgname=21mw-ir-emitter
pkgver=1.0.2
pkgrel=2
pkgdesc='Tiny helper for the Chicony IR emitter on Lenovo 21MW systems'
arch=('x86_64')
url='https://github.com/nathawatc/21mw-ir-emitter'
license=('Apache-2.0')
depends=('systemd')
makedepends=('gcc')
options=('!strip')

_tag=v${pkgver}

source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${_tag}.tar.gz")
b2sums=('034236955cb6f628f99af74178cfd80c78f2242cb4967f1df182de960d5a2a47fadc215baec2ed28d698dbc851799a3c7fcf0ececde60f1eb825b6d641c77bb2')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	make
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
