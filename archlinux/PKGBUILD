# Maintainer: Scott <158021536+nathawatc@users.noreply.github.com>
# shellcheck shell=bash disable=SC2034,SC2154,SC2164

pkgname=21mw-ir-emitter
pkgver=1.0.3
pkgrel=1
pkgdesc='Tiny helper for the Chicony IR emitter on Lenovo 21MW systems'
arch=('x86_64')
url='https://github.com/nathawatc/21mw-ir-emitter'
license=('Apache-2.0')
depends=('systemd')
makedepends=('gcc')
options=('!strip')

_tag=v${pkgver}

source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${_tag}.tar.gz")
b2sums=('3ed0b339c4a937593944efb962d4f33187155f4c9504b4ea2975ba3a9f51bf137e1b89c103701e0210ccd345a17cfb8e80f8dae0c964f5861177d0396ad45f75')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	make
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
}
