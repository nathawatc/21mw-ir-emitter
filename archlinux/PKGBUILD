# Maintainer: nathawat <nathawat[at]noreply[dot]codeberg[dot]org>

pkgname=21mw-ir-emitter
pkgver=1.0.2
pkgrel=1
pkgdesc='Tiny helper for the Chicony IR emitter on Lenovo 21MW systems'
arch=('x86_64')
url='https://codeberg.org/nathawat/21mw-ir-emitter'
license=('Apache-2.0')
depends=('systemd')
makedepends=('gcc')

_tag=v${pkgver}

source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${_tag}.tar.gz")
b2sums=('036ac85c40b67b83c948a710b315f16b4a5065781cba0c82b36cd51164088e2aa83387ae6c58ff3eeb2eabe53ab44c4fc9595268dea37970f1558c128431badc')

build() {
	cd "$srcdir/$pkgname"
	make
}

check() {
	cd "$srcdir/$pkgname"
	make check
}

package() {
	cd "$srcdir/$pkgname"
	make DESTDIR="$pkgdir" PREFIX=/usr install
}
